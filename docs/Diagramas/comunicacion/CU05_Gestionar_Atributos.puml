@startuml CU05_Gestionar_Atributos
title Communication Diagram — CU-05: Gestionar Atributos de una Clase

' Objetos
object ":Usuario" as user
object ":Inspector\n(React)" as inspector
object ":useClassesAndDetails\n(Hook)" as hook
object ":API Client\n(attributes)" as attrApi
object ":AxiosClient" as axios
object ":AtributosRouter\n(FastAPI)" as router
object ":Security" as security
object ":Atributo\n(SQLAlchemy)" as model
object ":PostgreSQL" as db
object ":realtime_events" as rtEvents
object ":WSManager" as wsManager
object ":Otros Clientes" as others

' === Crear atributo ===
user --> inspector : 1: click "Agregar atributo"
inspector --> hook : 1.1: addAttribute(classId, name, type, required)
hook --> attrApi : 1.2: createAttribute(classId, {name, type, required})
attrApi --> axios : 1.3: POST /diagrams/classes/{classId}/attributes
axios --> router : 1.4: HTTP POST
router --> security : 1.5: get_current_user(token)
router --> router : 1.6: verify class belongs to\naccessible diagram
router --> model : 1.7: Atributo(nombre, tipo, requerido, clase_id)
model --> db : 1.8: INSERT INTO atributo\n(UNIQUE: clase_id + nombre)
db --> model : 1.9: atributo row
router --> rtEvents : 1.10: notify("attribute.created")
rtEvents --> wsManager : 1.11: broadcast(diagramId, event)
wsManager --> others : 1.12: WebSocket JSON
router --> axios : 1.13: HTTP 201 AtributoOut
axios --> hook : 1.14: response.data
hook --> inspector : 1.15: update class details

' === Editar atributo ===
user --> inspector : 2: modifica nombre/tipo/required
inspector --> hook : 2.1: updateAttribute(attrId, changes)
hook --> attrApi : 2.2: updateAttribute(attrId, partial)
attrApi --> axios : 2.3: PATCH /diagrams/attributes/{attrId}
axios --> router : 2.4: HTTP PATCH
router --> model : 2.5: merge changes
model --> db : 2.6: UPDATE atributo SET ...
router --> rtEvents : 2.7: notify("attribute.updated")
rtEvents --> wsManager : 2.8: broadcast
wsManager --> others : 2.9: WebSocket event

' === Eliminar atributo ===
user --> inspector : 3: click "Eliminar" en atributo
inspector --> hook : 3.1: deleteAttribute(attrId)
hook --> attrApi : 3.2: deleteAttribute(attrId)
attrApi --> axios : 3.3: DELETE /diagrams/attributes/{attrId}
axios --> router : 3.4: HTTP DELETE
router --> model : 3.5: delete(atributo)
model --> db : 3.6: DELETE FROM atributo
router --> rtEvents : 3.7: notify("attribute.deleted")
rtEvents --> wsManager : 3.8: broadcast
router --> hook : 3.9: HTTP 200 {id, class_id}

@enduml
