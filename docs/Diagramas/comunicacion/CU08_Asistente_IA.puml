@startuml CU08_Asistente_IA
title Communication Diagram — CU-08: Editar Diagrama mediante Asistente de IA (Texto y Voz)

' Objetos
object ":Usuario" as user
object ":AiAssistantPanel\n(React)" as aiPanel
object ":ai.js\n(API Client)" as aiApi
object ":voice.js\n(API Client)" as voiceApi
object ":AxiosClient" as axios
object ":VoiceRouter\n(FastAPI)" as voiceRouter
object ":VoiceTranscribe\n(Service)" as voiceSvc
object ":AiRouter\n(FastAPI)" as aiRouter
object ":Security" as security
object ":BackgroundTasks\n(FastAPI)" as bgTasks
object ":AiAssistant\n(Service)" as aiSvc
object ":Gemini\n(Google AI)" as gemini
object ":DiagramToolExecutor\n(ai_tools.py)" as executor
object ":Diagram / Clase /\nAtributo / Metodo /\nRelacion (ORM)" as orm
object ":PostgreSQL" as db
object ":realtime_events" as rtEvents
object ":WSManager" as wsManager
object ":Frontend\n(WebSocket listener)" as wsClient

' === Flujo con VOZ (transcripción previa) ===
user --> aiPanel : 1: graba audio por micrófono
aiPanel --> voiceApi : 1.1: transcribeAudio(audioBlob)
voiceApi --> axios : 1.2: POST /voice/transcribe\n(multipart: audio file)
axios --> voiceRouter : 1.3: HTTP POST
voiceRouter --> security : 1.4: get_current_user(token)
voiceRouter --> voiceSvc : 1.5: transcribe_audio(content, mime)
voiceSvc --> gemini : 1.6: Gemini audio transcription
gemini --> voiceSvc : 1.7: transcribed text
voiceSvc --> voiceRouter : 1.8: text
voiceRouter --> axios : 1.9: HTTP 200 {text}
axios --> aiPanel : 1.10: transcribed text
aiPanel --> aiPanel : 1.11: set input = transcribed text

' === Flujo principal (texto → IA → edición) ===
user --> aiPanel : 2: escribe/confirma comando de texto
aiPanel --> aiApi : 2.1: sendAiCommand(diagramId, text)
aiApi --> axios : 2.2: POST /diagrams/{id}/ai/command\n{text}
axios --> aiRouter : 2.3: HTTP POST
aiRouter --> security : 2.4: get_current_user(token)
aiRouter --> aiRouter : 2.5: get_my_diagram (verify access)
aiRouter --> bgTasks : 2.6: add_task(run_command_background,\ndiagram_id, text)
aiRouter --> axios : 2.7: HTTP 202 {status: "processing"}
axios --> aiPanel : 2.8: "processing" (UI shows loading)

' === Procesamiento en background ===
bgTasks --> aiSvc : 3: run_command_background(diagram_id, text)
aiSvc --> rtEvents : 3.1: notify_ai_started(diagram_id, text)
rtEvents --> wsManager : 3.2: broadcast "ai.started"
wsManager --> wsClient : 3.3: WebSocket event → UI shows "AI working..."
aiSvc --> aiSvc : 3.4: build prompt with\ndiagram snapshot JSON
aiSvc --> gemini : 3.5: interactions.create(\nmodel, prompt, system_prompt, tools)
gemini --> aiSvc : 3.6: function_call steps\n(e.g. create_class, add_attribute)

' === Loop de tool execution (max 6 turns) ===
aiSvc --> executor : 4: executor.create_class(name, x, y)
executor --> orm : 4.1: Clase(nombre, diagram_id, ...)
orm --> db : 4.2: INSERT INTO clase
executor --> aiSvc : 4.3: {clase: name, id: uuid}
aiSvc --> executor : 4.4: executor.add_attribute(class, name, type)
executor --> orm : 4.5: Atributo(nombre, tipo, clase_id)
orm --> db : 4.6: INSERT INTO atributo
executor --> aiSvc : 4.7: {atributo: name, clase: class}
aiSvc --> gemini : 4.8: function_results\n(previous_interaction_id)
gemini --> aiSvc : 4.9: text reply OR more function_calls

' === Resultado final ===
aiSvc --> rtEvents : 5: notify_ai_done(diagram_id,\nreply, actions)
rtEvents --> wsManager : 5.1: broadcast "ai.done"
wsManager --> wsClient : 5.2: WebSocket event
wsClient --> aiPanel : 5.3: show AI reply text +\nrefresh diagram elements

@enduml
